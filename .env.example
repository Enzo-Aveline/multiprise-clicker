# Fichier d'exemple pour les variables d'environnement locales
# 1. Copiez ce fichier et renommez-le en ".env.local"
# 2. Remplacez les valeurs ci-dessous par celles de votre projet Supabase (Project Settings > API)

VITE_SUPABASE_URL=https://votre-id-de-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique-très-longue
